# Local Docker Compose defaults for development and integration testing.
# Copy this file to compose/secrets.dev.env before running `docker compose up`.
# Do not use these values in production.

# Neo4j
# Keep NEO4J_AUTH in sync with NEO4J_PASSWORD when changing local credentials.
NEO4J_PASSWORD=changeme
NEO4J_AUTH=neo4j/changeme

# Postgres
# Keep DATABASE_URL in sync with POSTGRES_PASSWORD when changing local credentials.
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://postgres:changeme@postgres:5432/chain_analysis

# ClickHouse
CLICKHOUSE_PASSWORD=changeme

# Auth
JWT_SECRET_KEY=changeme

# Optional ingestion providers. Leave blank to run without live provider credentials.
ETHERSCAN_API_KEY=
ALCHEMY_API_KEY=
INGEST_SOURCE=
