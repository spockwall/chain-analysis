# Environment Configuration
# Copy this file to .env and fill in the values

# Environment: local, aws, gcp
ENVIRONMENT=local

# =============================================================================
# Graph Database (Neo4j)
# =============================================================================
GRAPH_DB_PROVIDER=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# =============================================================================
# PostgreSQL
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chain_analysis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123

# Async connection string (used by asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres123@localhost:5432/chain_analysis

# Sync connection string (used by Alembic)
DATABASE_URL_SYNC=postgresql://postgres:postgres123@localhost:5432/chain_analysis

# =============================================================================
# Message Queue
# =============================================================================
QUEUE_PROVIDER=redis
REDIS_URL=redis://localhost:6379

# Kafka (alternative)
# QUEUE_PROVIDER=kafka
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# SQS (AWS)
# QUEUE_PROVIDER=sqs
# AWS_REGION=us-east-1
# SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/chain-analysis

# =============================================================================
# Object Storage
# =============================================================================
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=chain-analysis

# S3 (AWS)
# STORAGE_PROVIDER=s3
# AWS_S3_BUCKET=chain-analysis-data
# AWS_REGION=us-east-1

# GCS (GCP)
# STORAGE_PROVIDER=gcs
# GCS_BUCKET=chain-analysis-data
# GCS_PROJECT_ID=my-project

# =============================================================================
# Data Sources
# =============================================================================
ALLIUM_API_KEY=your_allium_api_key_here
ALLIUM_BASE_URL=https://api.allium.so

# Etherscan (fallback)
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# =============================================================================
# API Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# =============================================================================
# Dagster
# =============================================================================
DAGSTER_HOME=/tmp/dagster

# =============================================================================
# Rust Workers
# =============================================================================
RUST_WORKER_LOG_LEVEL=info
INGEST_BATCH_SIZE=1000
INGEST_PARALLELISM=4
