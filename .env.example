# Copy this file to `.env` in the repo root. Docker Compose auto-loads it
# for ${VAR} interpolation in compose/*.yml. All other values (Neo4j /
# Postgres / Redis / MinIO credentials, JWT secret, service URLs) are
# hardcoded for local dev in the compose files — override them by editing
# those files or adding a `compose/local.override.yml`.

# =============================================================================
# Data sources (optional — without both, Rust `ingest` falls back to
# deterministic mock data, useful for smoke-testing pipeline plumbing but
# not for real on-chain queries)
# =============================================================================

# Etherscan V2 proxy — primary. Free key at https://etherscan.io/apis.
# Required for: web-triggered ingest (/api/pipeline/ingest-address), the
# /labels targeted queue, and `ingest targeted hashes|neighborhood`.
ETHERSCAN_API_KEY=4D5DBZ7BETQFHPJUF45XEIRWA3G6ZWJ8U4

# Alchemy JSON-RPC — alternative block-mode source. Only used when
# INGEST_SOURCE=alchemy; leave unset to default to Etherscan.
ALCHEMY_API_KEY=

# Which source `ingest block` uses. Options: etherscan (default), alchemy.
INGEST_SOURCE=
