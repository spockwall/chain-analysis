ENVIRONMENT=production

# Neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=<required-in-prod>
NEO4J_HEAP_SIZE=1G
NEO4J_MAX_HEAP=2G
NEO4J_PAGECACHE_SIZE=1G

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=chain_analysis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<required-in-prod>

# Redis
REDIS_PASSWORD=<required-in-prod>
REDIS_URL=redis://:<required-in-prod>@redis:6379

# ClickHouse
CLICKHOUSE_DB=chain_analysis
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=<required-in-prod>

# Auth
JWT_SECRET_KEY=<generate with: openssl rand -base64 64>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# API
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
CORS_ORIGINS=["https://localhost"]

# Data Sources
ETHERSCAN_API_KEY=
ALCHEMY_API_KEY=
INGEST_SOURCE=
